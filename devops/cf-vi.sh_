../wg-mgr.sh install -c ./conf-vi.conf -i wg0 --ip4 10.16.16.1/24 --dns '1.1.1.1,1.0.0.1' -w ../.wg-temp \
  -r ../nftables/nft.rules \
  --debug --dry-run \
  -t "WG_NET=10.16.16.0/24" \
  -t "NFT_COUNTER=counter; NFT_SEARCH_DOMAIN_LOCALNET=\"home.lan klinika.lan\"" \
  --option "PROVIDER_GW_MAC=" \
  --option "NFT_NAT_NET=\"10.16.19.0/24, 192.168.15.0/24, 192.168.16.0/24,192.168.22.0/24, 192.168.25.0/24,192.168.26.0/24\"" \
  --option "NFT_LIST_TRUST_WAN='cl.vpn.mrovo.ru, cl-ang.vpn.mrovo.ru, 4v.vpn.mrovo.ru,fn.vpn.mrovo.ru'" \
  --option "NFT_LIST_VPN=" \
  --option "NFT_LIST_VPN_ONLY=" \
  --option "NFT_LIST_INET_DROP=" \
  --option "NFT_LIST_TRUST_VPN=\"10.16.16.2,10.16.16.3,10.16.16.4,10.16.16.5,10.16.16.6,10.16.16.7,10.16.16.254,192.168.15.0/24,192.168.16.0/24\"" \
  --option "NFT_DNS_LOCALNET=192.168.15.3" \
  $@
#cat ./hand_params.conf
echo '=============================================================================================================================='
#env
exit 0

  --option "NFT_MAP_DNAT=\"type inet_proto . inet_service : ipv4_addr . inet_service;
    elements={
      tcp . 80   : 192.168.15.79 . 80,
      tcp . 443  : 192.168.15.79 . 443,
      tcp . 8080 : 192.168.16.79 . 80,
      tcp . 8443 : 192.168.16.79 . 443
    }
  \"" \
  --option "NFT_MAP_FORWARD_ACL=\" type ipv4_addr . inet_proto . inet_service : verdict; 
    elements={
      192.168.15.79 . tcp . 80  : accept,
      192.168.15.79 . tcp . 443 : accept,
      192.168.16.79 . tcp . 80  : accept,
      192.168.16.79 . tcp . 443 : accept
    }
  \"" \
