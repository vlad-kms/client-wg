#!/bin/bash

#./wg-mgr.sh prepare -c c13.conf -i wg0 --ip4 10.16.18.1/24 --dns 192.168.15.3 -r nftables/nft.rules  -w ./.wg-temp -t "WG_PROTO=udp; NFT_COUNTER=counter; NFT_SEARCH_DOMAIN_LOCALNET=\"home.lan klinika.lan\"; SSH_PORT=22" --debug --dry-run --option "NFT_LIST_VPN_ONLY=\"192.168.1.254, 10.16.18.100\"";  cat .wg-temp/han
../wg-mgr.sh install -c ../.wg-temp/conf.conf -i awg0 --ip4 10.9.8.1/24 --dns 192.168.15.3 -w ../.wg-temp \
  -r ../nftables/nft.rules \
  -e 1.1.1.1/0 \
  --debug --dry-run \
  -t "NFT_COUNTER=counter; NFT_SEARCH_DOMAIN_LOCALNET=\"home.lan klinika.lan\"" \
  --option "PROVIDER_GW_MAC=\"08:05:e2:fa:07:f0\"" \
  --option "NFT_LIST_VPN_ONLY="\
  --option "NFT_LIST_TRUST_VPN=" \
  --option "NFT_NAT_NET=\"192.168.15.0/24, 192.168.16.0/24,192.168.25.0/24,192.168.26.0/24\"" \
  --option "NFT_LIST_TRUST_WAN='cl.vpn.mrovo.ru, cl-ang.vpn.mrovo.ru'" \
  --option "NFT_LIST_VPN_ONLY=" \
  --option "NFT_LIST_INET_DROP=" \
  --option "NFT_LIST_TRUST_VPN=\"192.168.15.202,10.9.8.2,10.9.8.3,10.9.8.4,10.9.8.5,10.9.8.6,10.9.8.7,192.168.16.55\"" \
  --option "NFT_DNS_LOCALNET=192.168.15.3" \
  --option 'NFT_MAP_FORWARD_ACL="192.168.15.79 . tcp . 80 : accept, 192.168.15.79 . tcp . 443 : accept"' \
  --option 'NFT_MAP_DNAT="
      tcp . 443 : 192.168.15.79 . 443,
      tcp . 80 : 192.168.15.79 . 80
    "' \
  --option 'NFT_USE_ARP_TABLE=1' \
  $@
cat ./hand_params.conf

exit 0

nft add rule ip nat prerouting iifname "ens3" dport 80 dnat to 192.168.15.79:80

  --option "NFT_ALLOWED_SERVICES='tcp . 80, tcp . 443'" \
  --option "NFT_ALLOWED_SERVICES_VPN='tcp . 8080, tcp . 162, tcp 10061'" \
