#!/bin/bash

awg_table=awg_table
awg_table_arp=awg_table_arp
awg_table_mangle=awg_mangle
std_table_filter=filter
std_table_nat=nat

name_chain_awg_input=awg_input
name_chain_awg_forward=awg_forward
name_chain_scan_port=scan_port
name_chain_logdrop=logdrop
name_chain_logrej=logrej
name_set_awg_nat_net=awg_nat_net
name_set_nat_inet_drop=nat_inet_drop
name_set_awg_vpn=awg_vpn
name_set_awg_vpn_only=awg_vpn_only

name_set_awg_portscan=awg_portscan
name_set_awg_ssh_ban=awg_ssh_ban
name_set_awg_trust_wan=awg_trust_wan
name_set_awg_trust_vpn=awg_trust_vpn

family=inet
awg_priority=10

awg_counter="${NFT_COUNTER:-}"

predefined_rule_0="iif \"lo\" ${awg_counter} accept "
predefined_rule_1="ct state established,related ${awg_counter} accept"
predefined_rule_2="ct state invalid ${awg_counter} drop"

trust_wan='cl.vpn.mrovo.ru, cl-ang.vpn.mrovo.ru'
trust_vpn='192.168.15.202, 10.9.8.2, 10.9.8.3, 10.9.8.4, 10.9.8.5, 10.9.8.6, 10.9.8.7'
nat_net="192.168.15.0/24, 192.168.16.0/24, 192.168.22.0/24, 192.168.25.0/24, 192.168.26.0/24, $WG_NET"
nat_inet_drop="192.168.15.129"
awg_vpn="192.168.16.55"
awg_vpn_only="192.168.15.99"

mark_only_inet=120
mark_only_vpn=110
mark_all=100
mark_inet=0x100
mark_vpn=0x200
mask_not_inet=0xFEFF
mask_not_vpn=0xFDFF
#!/vcbvc/vbvcb

tmpfile="$(mktemp)"

#!/bin/sh
_CLEANED_=0
_cleanup() {
  if [ ${_CLEANED_} -eq 0 ]; then
    _CLEANED_=1
    [ -n "$tmpfile" ] && rm -f "$tmpfile"
    [ -n "$tmpfile_bak_rules" ] && rm -f "$tmpfile_bak_rules"
  fi
#  if [ -z "$1" ]; then
#    exit 0
#  else
#    exit $1
#  fi
}
_cleanup_emergency() {
  _cleanup
  exit $1
}

trap _cleanup EXIT 
trap _cleanup_emergency SIGINT SIGTERM

# $1 - regexp для поиска
# $2 - где ищем
# Возврат:
#   0 - нашли элемент $2 со значением $1
#   1 - не нашли элемент $2 со значением $1
#   2 - не передали либо что искать, либо где искать, либо оба 
get_handle_elem() {
  if [ -z "$1" ] || [ -z "$2" ]; then
    printf ""
    return 1
  fi
  res=$(nft -a list "$2" 2>/dev/null | grep "$1" | grep -o 'handle [0-9]*' | awk '{print $2}')
  if [ -z "$res" ]; then
    printf ""
    return 2
  else
    printf "$res"
    return 0
  fi
}

safe_apply_rules() {
  local rule_file="$1"
        
  # Проверка синтаксиса
  if ! nft -c -f "$rule_file" 2>/dev/null; then
    echo "Ошибка в синтаксисе правил!"
    nft -c -f "$rule_file"  # Покажет ошибку
    return 1
  fi
                                                
  # Создать бэкап
  tmpfile_bak_rules="/tmp/nft_backup_$(date +%s).rules"
  nft list ruleset > "$tmpfile_bak_rules"
                                                                
  # Применить правила
  if ! nft -f "$rule_file"; then
    echo "Ошибка применения правил! Восстанавливаем бэкап..."
    nft -f "$tmpfile_bak_rules"
    return 1
  fi
                                                                                                        
  echo "Правила успешно применены"
  return 0
}

# ==================================================================================================================================================
init_nft() {
  cat > "$tmpfile" << EOF
# сделать цепочки без хуков, т.е. вызываемые из соответствующих стандартных с хуками

  # TABLE arp $awg_table_arp %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
add table arp $awg_table_arp
add chain arp $awg_table_arp input  { type filter hook input priority filter - $awg_priority; policy drop; }
add chain arp $awg_table_arp output { type filter hook output priority filter - $awg_priority; policy accept; }
  # Разрешаем ARP-ответы ТОЛЬКО от легитимного шлюза провайдера
add rule arp $awg_table_arp input iifname "$SERVER_PUB_NIC" arp saddr ip $DEFAULT_ROUTE arp saddr ether ${PROVIDER_GW_MAC} accept comment "Разрешить только от шлюза провайдера"
  # Разрешаем ЛЮБЫЕ входящие ARP-запросы к нашему серверу (чтобы другие видели нас)
  # Но ЗАПРЕЩАЕМ входящие ARP-ответы (reply) от кого-либо, кроме шлюза из п.1
add rule arp $awg_table_arp input iifname "$SERVER_PUB_NIC" arp operation request accept comment "Разрешаем ARP-запросы к нам"

  # TABLE inet $awg_table_mangle %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
add table $family $awg_table_mangle
  # ---
add set $family $awg_table_mangle $name_set_awg_nat_net   { type ipv4_addr; flags interval; }
add set $family $awg_table_mangle $name_set_nat_inet_drop { type ipv4_addr; flags interval; }
add set $family $awg_table_mangle $name_set_awg_vpn_only  { type ipv4_addr; flags interval; }
add set $family $awg_table_mangle $name_set_awg_vpn       { type ipv4_addr; flags interval; }
add set $family $awg_table_mangle $name_set_awg_trust_vpn { type ipv4_addr; flags interval; }
  # --- elements sets
add element $family $awg_table_mangle $name_set_awg_nat_net   { $nat_net }
add element $family $awg_table_mangle $name_set_nat_inet_drop { $nat_inet_drop }
add element $family $awg_table_mangle $name_set_awg_vpn       { $awg_vpn }
add element $family $awg_table_mangle $name_set_awg_vpn_only  { $awg_vpn_only }
add element $family $awg_table_mangle $name_set_awg_trust_vpn { $trust_vpn }
  # --- rules
add chain $family $awg_table_mangle prerouting {type filter hook prerouting priority mangle - $awg_priority; policy accept;}
add chain $family $awg_table_mangle forward {type filter hook forward priority filter - $awg_priority; policy accept;}
  # Оптимизация TCP MSS для VPN/PPPoE (исключает фрагментацию)
add rule $family $awg_table_mangle forward ${awg_counter} tcp flags syn tcp option maxseg size set rt mtu
add rule $family $awg_table_mangle prerouting iifname "$SERVER_WG_NIC" ip saddr { 192.168.15.99, 192.168.15.129, 192.168.16.55, 192.168.15.202 } meta nftrace set 1
  # --- set marks
  # БАЗОВОЕ ПРАВИЛО: Всем клиентам сети по умолчанию разрешаем только Интернет (0x100)
add rule $family $awg_table_mangle prerouting iifname "$SERVER_WG_NIC" ip saddr @${name_set_awg_nat_net} ct state new ${awg_counter} ct mark set ${mark_inet} comment "Выход в INET"
  # МОДИФИКАТОР LAN: Если клиент в списке awg_vpn или awg_vpn_only — добавляем ему флаг LAN (0x200)
  # Используем побитовое ИЛИ (|), чтобы сохранить уже имеющийся 0x100 (для awg_vpn)
add rule $family $awg_table_mangle prerouting iifname "$SERVER_WG_NIC" ip saddr @${name_set_awg_vpn} ct state new ${awg_counter} ct mark set ct mark | ${mark_vpn} comment "Флаг выхода в LAN"
add rule $family $awg_table_mangle prerouting iifname "$SERVER_WG_NIC" ip saddr @${name_set_awg_vpn_only} ct state new ${awg_counter} ct mark set ct mark | ${mark_vpn} comment "Флаг выхода в LAN"
  # МОДИФИКАТОР DROP: Если клиент в списке drop или vpn_only — СТИРАЕМ флаг Интернета (0x100)
  # Маска 0x0000feff выключит бит 0x100, но сохранит бит 0x200, если он был установлен на шаге 3
add rule $family $awg_table_mangle prerouting iifname "$SERVER_WG_NIC" ip saddr @${name_set_nat_inet_drop} ct state new ${awg_counter} ct mark set ct mark & ${mask_not_inet} comment "НЕТ выхода в INET"
add rule $family $awg_table_mangle prerouting iifname "$SERVER_WG_NIC" ip saddr @${name_set_awg_vpn_only}  ct state new ${awg_counter} ct mark set ct mark & ${mask_not_inet} comment "НЕТ выхода в INET"
add rule $family $awg_table_mangle prerouting ${awg_counter} meta mark set ct mark

  # TABLE inet filter %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  # --- SETS
add set $family $std_table_filter $name_set_awg_portscan { type ipv4_addr; flags dynamic, timeout; size 65535; timeout 24h; }
add set $family $std_table_filter $name_set_awg_ssh_ban { type ipv4_addr; flags dynamic, timeout; size 65535; timeout 2h; }
  # ---
add set $family $std_table_filter $name_set_awg_trust_wan { type ipv4_addr; flags interval; }
add set $family $std_table_filter $name_set_awg_trust_vpn { type ipv4_addr; flags interval; }
  # ---
add set $family $std_table_filter $name_set_awg_nat_net { type ipv4_addr; flags interval; }
  # ---
#add set $family $std_table_filter $name_set_nat_inet_drop { type ipv4_addr; flags interval; }
#add set $family $std_table_filter $name_set_awg_vpn_only  { type ipv4_addr; flags interval; }

  # CHAINS %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
  # --- create chain $name_chain_logdrop
add chain $family $std_table_filter $name_chain_logdrop
#flush chain $family $std_table_filter $name_chain_logdrop
add rule  $family $std_table_filter $name_chain_logdrop ${awg_counter} log prefix "DROPPED: "
add rule  $family $std_table_filter $name_chain_logdrop ${awg_counter} drop
  # --- create chain logrej
add chain $family $std_table_filter $name_chain_logrej
#flush chain $family $std_table_filter $name_chain_logrej
add rule $family $std_table_filter $name_chain_logrej ${awg_counter} log prefix "REJECTED: "
add rule $family $std_table_filter $name_chain_logrej meta l4proto tcp ${awg_counter} reject with tcp reset
add rule $family $std_table_filter $name_chain_logrej meta l4proto udp ${awg_counter} reject
add rule $family $std_table_filter $name_chain_logrej ${awg_counter} reject with icmp type prot-unreachable
  # --- create chain scan_port
add chain $family $std_table_filter $name_chain_scan_port
# add rule $family $std_table_filter $name_chain_scan_port ip saddr @${name_set_awg_portscan} ${awg_counter} drop
# add rule $family $std_table_filter $name_chain_scan_port ip saddr @${name_set_awg_ssh_ban}  ${awg_counter} drop
add rule $family $std_table_filter  $name_chain_scan_port ip saddr @${name_set_awg_portscan} ${awg_counter} reject with icmp port-unreachable
add rule $family $std_table_filter  $name_chain_scan_port ip saddr @${name_set_awg_ssh_ban} ${awg_counter} reject with icmp port-unreachable
add rule  $family $std_table_filter $name_chain_scan_port tcp flags fin / fin,ack ${awg_counter} add @${name_set_awg_portscan} { ip saddr timeout 24h } ${awg_counter} jump logdrop
add rule  $family $std_table_filter $name_chain_scan_port tcp flags fin,syn,rst,psh,ack,urg / fin,syn,rst,psh,ack,urg add @${name_set_awg_portscan} { ip saddr timeout 24h } ${awg_counter} jump logdrop
add rule  $family $std_table_filter $name_chain_scan_port tcp flags ! fin,syn,rst,psh,ack,urg add @${name_set_awg_portscan} { ip saddr timeout 24h } ${awg_counter} jump logdrop
  # ЗАЩИТА ОТ СКАНЕРОВ ПОРТОВ (Port Scan Protection)
  # Блокируем "закрытые" порты. Если атакующий обращается к портам, 
  # которые не используются (например, 1-21, 23-79), его IP улетает в бан на 24 часа.
add rule $family $std_table_filter  $name_chain_scan_port tcp dport { 1-21, 23-79, 81-442, 444-65535 } iifname "$SERVER_PUB_NIC" \
    add @${name_set_awg_portscan} { ip saddr timeout 24h } ${awg_counter} \
    drop comment "ANTI scan tcp"
# add rule $family $std_table_filter  $name_chain_scan_port udp dport { 1-$(( $SERVER_PORT - 1 )), $(( $SERVER_PORT + 1 ))-65535 } iifname "$SERVER_PUB_NIC" \
#     add @${name_set_awg_portscan} { ip saddr timeout 24h } ${awg_counter} drop
add rule $family $std_table_filter  $name_chain_scan_port udp dport \
    { $(if [ $SERVER_PORT -eq 1 ]; then echo "2-65535"; else echo "1-$(( $SERVER_PORT - 1 )), $(( $SERVER_PORT + 1 ))-65535"; fi) } \
    iifname "$SERVER_PUB_NIC" \
    add @${name_set_awg_portscan} { ip saddr timeout 24h } ${awg_counter} drop \
    comment "ANTI scan udp"
  # ЗАЩИТА SSH ОТ БРУТФОРСА (SSH Bruteforce Protection)
  # Разрешено не более 4 новых подключений в минуту. Превышение = бан на 2 часа.
add rule  $family $std_table_filter $name_chain_scan_port tcp dport 22 ct state new iifname "$SERVER_PUB_NIC" \
    limit rate over 4/minute \
    add @${name_set_awg_ssh_ban} { ip saddr timeout 2h } ${awg_counter} drop \
    comment "Не более 4 новых подключений в минуту"
  # Разрешено не более 10 новых подключений за 1 час. Превышение = бан на 4 часа.
add rule  $family $std_table_filter $name_chain_scan_port tcp dport 22 ct state new iifname "$SERVER_PUB_NIC" \
    limit rate over 10/hour burst 4 packets \
    add @${name_set_awg_ssh_ban} { ip saddr timeout 4h } ${awg_counter} drop \
    comment "Не более 10 новых подключений за 1 час"
  # Возврат для чистых пакетов
add rule  $family $std_table_filter $name_chain_scan_port ${awg_counter} return
  # --- INPUT $name_chain_awg_input
add chain $family $std_table_filter $name_chain_awg_input
#add rule  $family $std_table_filter $name_chain_awg_input tcp dport 22 meta nftrace set 1
add rule  $family $std_table_filter $name_chain_awg_input $predefined_rule_0 comment "Разрешить все на интерфейсе lo"
add rule  $family $std_table_filter $name_chain_awg_input $predefined_rule_1 comment "Разрешить stateless"
add rule  $family $std_table_filter $name_chain_awg_input $predefined_rule_2 comment "Запретить invalid"
add rule  $family $std_table_filter $name_chain_awg_input iifname "$SERVER_PUB_NIC" udp dport $SERVER_PORT ${awg_counter} accept comment "Разрешить AmneziaWG"
add rule  $family $std_table_filter $name_chain_awg_input iifname "$SERVER_PUB_NIC" ip saddr @${name_set_awg_trust_wan} tcp dport $SSH_PORT ct state new ${awg_counter} accept comment "Разрешить SSH для доверенных на $SERVER_PUB_NIC"
add rule  $family $std_table_filter $name_chain_awg_input iifname "$SERVER_WG_NIC" ip saddr @${name_set_awg_trust_vpn} ct state new ${awg_counter} accept comment "Разрешить все с доверенных на $SERVER_WG_NIC"
add rule  $family $std_table_filter $name_chain_awg_input iifname "$SERVER_PUB_NIC" ${awg_counter} jump scan_port comment "Антисканер портов, брутфорса SSH и т.д."
add rule  $family $std_table_filter $name_chain_awg_input iifname "$SERVER_PUB_NIC" tcp dport $SSH_PORT ct state new ${awg_counter} accept comment "Разрешить SSH для остальных"
# add rule  $family $std_table_filter $name_chain_awg_input iifname "$SERVER_WG_NIC" tcp dport $SSH_PORT ct state new ${awg_counter} accept comment "Разрешить SSH для остальных"
add rule  $family $std_table_filter $name_chain_awg_input ${awg_counter} return

  # --- FORWARD $name_chain_awg_forward
add chain $family $std_table_filter $name_chain_awg_forward
#add rule  $family $std_table_filter $name_chain_awg_forward $predefined_rule_0 comment "Разрешить все на интерфейсе lo"
add rule $family $std_table_filter $name_chain_awg_forward $predefined_rule_1 comment "Разрешить stateless"
add rule $family $std_table_filter $name_chain_awg_forward $predefined_rule_2 comment "Запретить invalid"
add rule $family $std_table_filter $name_chain_awg_forward iifname "$SERVER_WG_NIC" oifname  "$SERVER_PUB_NIC" ip saddr { 192.168.15.99, 192.168.15.129,192.168.16.55, 192.168.15.202 } meta nftrace set 1
add rule $family $std_table_filter $name_chain_awg_forward iifname "$SERVER_WG_NIC" ip saddr @${name_set_awg_trust_vpn} ${awg_counter} accept
#add rule $family $std_table_filter $name_chain_awg_forward iifname "$SERVER_WG_NIC" oifname  "$SERVER_PUB_NIC" meta mark & ${mark_inet} == ${mark_inet} ${awg_counter} accept
#add rule $family $std_table_filter $name_chain_awg_forward iifname "$SERVER_WG_NIC" oifname  "$SERVER_WG_NIC" meta mark & ${mark_vpn} == ${mark_vpn} ${awg_counter} accept
add rule $family $std_table_filter $name_chain_awg_forward iifname "$SERVER_WG_NIC" oifname  "$SERVER_PUB_NIC" ct mark & ${mark_inet} == ${mark_inet} ${awg_counter} accept
add rule $family $std_table_filter $name_chain_awg_forward iifname "$SERVER_WG_NIC" oifname  "$SERVER_WG_NIC"  ct mark & ${mark_vpn} == ${mark_vpn} ${awg_counter} accept
add rule $family $std_table_filter $name_chain_awg_forward ${awg_counter} return

  # --- сделать вызов $name_chain_awg_input из $std_table_filter.input
insert rule $family $std_table_filter input ${awg_counter} jump $name_chain_awg_input
chain $family $std_table_filter input { policy drop; }
  # --- сделать вызов $name_chain_awg_forward из $std_table_filter.forward
insert rule $family $std_table_filter forward ${awg_counter} jump $name_chain_awg_forward
chain $family $std_table_filter forward { policy drop; }

  # --- установка элементов sets
add element $family $std_table_filter $name_set_awg_trust_wan { $trust_wan }
add element $family $std_table_filter $name_set_awg_trust_vpn { $trust_vpn }
  # ---
add element $family $std_table_filter $name_set_awg_nat_net { $nat_net }

EOF
  #nft -f "$tmpfile"
  if ! safe_apply_rules "$tmpfile"; then exit 1; fi
}

destroy_awg_table() {
  #table awg_table_arp
  if nft -a list tables | grep -E "table.*$awg_table_arp" 2>&1 >/dev/null; then
    nft delete table arp $awg_table_arp
  fi
  # --- $awg_table_mangle
  if nft -a list tables | grep -E "table.*$awg_table_mangle" 2>&1 >/dev/null; then
    nft delete table $family $awg_table_mangle
  fi
  # удалить вызов chain $name_chain_awg_input из $std_table_filter.input
  handle_awg_input="$(get_handle_elem "chain $name_chain_awg_input" "chain $family $std_table_filter $name_chain_awg_input")"
  hn="$(get_handle_elem "jump $name_chain_awg_input" "chain $family $std_table_filter input")"
  #echo "handle awg_input: $is_awg_input"
  #echo -e "rule jump awg_input:\n$hn\n"
  if [[ -n "$hn" ]] && [[ -n $handle_awg_input ]]; then
    echo "$hn" | xargs -I {} nft delete rule $family $std_table_filter input handle {};
  fi
  if [[ -n $handle_awg_input ]]; then
    echo "$handle_awg_input" | xargs -I {} nft delete chain $family $std_table_filter handle {};
  fi
  # удалить вызов chain $name_chain_awg_forward из $std_table_filter.forward
  handle_awg_forward="$(get_handle_elem "chain $name_chain_awg_forward" "chain $family $std_table_filter $name_chain_awg_forward")"
  hn="$(get_handle_elem "jump $name_chain_awg_forward" "chain $family $std_table_filter forward")"
  #echo "handle awg_forward: $is_awg_forward"
  #echo -e "rule jump awg_forward:\n$hn\n"
  if [[ -n "$hn" ]] && [[ -n $handle_awg_forward ]]; then
    echo "$hn" | xargs -I {} nft delete rule $family $std_table_filter forward handle {};
  fi
  if [[ -n $handle_awg_forward ]]; then
    echo "$handle_awg_forward" | xargs -I {} nft delete chain $family $std_table_filter handle {};
  fi
  # chain $name_chain_awg_input
  if nft -a list table $family $std_table_filter | grep -e "chain.*$name_chain_awg_input" 2>&1 >/dev/null; then
    #nft flush chain $family $std_table_filter $name_chain_awg_input
    nft delete chain $family $std_table_filter $name_chain_awg_input
  fi
  # chain $name_chain_scan_port
  if nft -a list table $family $std_table_filter | grep -e "chain.*$name_chain_scan_port" 2>&1 >/dev/null; then
    #nft flush chain $family $std_table_filter $name_chain_scan_port
    nft delete chain $family $std_table_filter $name_chain_scan_port
  fi
  # chain $name_chain_logdrop
  if nft -a list table $family $std_table_filter | grep -e "chain.*$name_chain_logdrop" 2>&1 >/dev/null; then
    #nft flush chain $family $std_table_filter $name_chain_logdrop
    nft delete chain $family $std_table_filter $name_chain_logdrop
  fi
  # chain $name_chain_logrej
  if nft -a list table $family $std_table_filter | grep -e "chain.*$name_chain_logrej" 2>&1 >/dev/null; then
    #nft flush chain $family $std_table_filter $name_chain_logrej
    nft delete chain $family $std_table_filter $name_chain_logrej
  fi
  # set $name_set_awg_nat_net
  if nft -a list table $family $std_table_filter | grep -e "set.*$name_set_awg_nat_net" 2>&1 >/dev/null; then
    #nft flush set $family $std_table_filter $name_set_awg_nat_net
    nft delete set $family $std_table_filter $name_set_awg_nat_net
  fi
  # set $name_set_nat_inet_drop
  if nft -a list table $family $std_table_filter | grep -e "set.*$name_set_nat_inet_drop" 2>&1 >/dev/null; then
    #nft flush set $family $std_table_filter $name_set_nat_inet_drop
    nft delete set $family $std_table_filter $name_set_nat_inet_drop
  fi
  # set $name_set_awg_vpn_only
  if nft -a list table $family $std_table_filter | grep -e "set.*$name_set_awg_vpn_only" 2>&1 >/dev/null; then
    #nft flush set $family $std_table_filter $name_set_awg_vpn_only
    nft delete set $family $std_table_filter $name_set_awg_vpn_only
  fi
  # set $name_set_awg_trust_wan
  if nft -a list table $family $std_table_filter | grep -e "set.*$name_set_awg_trust_wan" 2>&1 >/dev/null; then
    #nft flush set $family $std_table_filter $name_set_awg_trust_wan
    nft delete set $family $std_table_filter $name_set_awg_trust_wan
  fi
  # set $name_set_awg_trust_vpn
  if nft -a list table $family $std_table_filter | grep -e "set.*$name_set_awg_trust_vpn" 2>&1 >/dev/null; then
    #nft flush set $family $std_table_filter $name_set_awg_trust_vpn
    nft delete set $family $std_table_filter $name_set_awg_trust_vpn
  fi
  # set $name_set_awg_portscan
  if nft -a list table $family $std_table_filter | grep -e "set.*$name_set_awg_portscan" 2>&1 >/dev/null; then
    #nft flush set $family $std_table_filter $name_set_awg_portscan
    nft delete set $family $std_table_filter $name_set_awg_portscan
  fi
  # set $name_set_awg_ssh_ban
  if nft -a list table $family $std_table_filter | grep -e "set.*$name_set_awg_ssh_ban" 2>&1 >/dev/null; then
    #nft flush set $family $std_table_filter $name_set_awg_ssh_ban
    nft delete set $family $std_table_filter $name_set_awg_ssh_ban
  fi
  # установить для цепочек filter.input, filter.output, filter.forward policy accept
  nft chain $family $std_table_filter input   { policy accept\; }
  nft chain $family $std_table_filter output  { policy accept\; }
  nft chain $family $std_table_filter forward { policy accept\; }
}

#######################################################
#######################################################
#######################################################
if [ "$EUID" -ne 0 ]; then
  echo "Пожалуйста, запустите с правами root (sudo)"
  exit 1
fi

action="$1"
if [ -n "$(echo "$1" | sed -En 's/^(d(el|elete|estroy)?)$/\1/ip')" ]; then
  is_add=false
  action='del'
elif [ -n "$(echo "$1" | sed -En 's/^(a(dd)?|i(nit)?)$/\1/ip')" ]; then
  is_add=true
  action='add'
else
  action=''
fi                

if [ -z "$action" ] || [ "$action" = "" ]; then
  echo "Должена быть указана обязательная команда: add(a,init,i) или del(d,delete,destroy)"
  exit 1
fi
#echo $action

DEFAULT_ROUTE="$(ip r | grep 'default' | grep -o 'via [0-9.]*' | awk '{print $2}')"
DEFAULT_ROUTE="${DEFAULT_ROUTE:-$PROVIDER_GW_IP}"

required_vars="SERVER_PUB_NIC SERVER_WG_NIC SERVER_PORT SSH_PORT PROVIDER_GW_MAC DEFAULT_ROUTE"
missing_vars=""
for var in $required_vars; do
  if [ -z "${!var:-}" ]; then
    missing_vars="$missing_vars $var"
  fi
done
if [ -n "$missing_vars" ]; then
  echo "❌ Ошибка: Не определены переменные:$missing_vars"
  echo "   Проверьте файлы конфигурации в $dir_conf/"
  exit 1
fi

if [ "$action" = "del" ]; then
  destroy_awg_table
elif [ "$action" = "add" ]; then
  destroy_awg_table
  init_nft
else
  echo "Должена быть указана обязательная команда: add(a,init,i) или del(d,delete,destroy)"
  exit 1
fi

exit 0
